#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PG_VERSION_NUM
 PRODUCTVERSION PG_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ProxyGrid"
            VALUE "FileDescription", "ProxyGridVPN DNS leak protection"
            VALUE "FileVersion", PG_VERSION_STR
            VALUE "InternalName", "smartdnsblock"
            VALUE "LegalCopyright", "Copyright 2018 The Outline Authors. Copyright 2026 ProxyGrid. Apache License 2.0."
            VALUE "OriginalFilename", "smartdnsblock.exe"
            VALUE "ProductName", "ProxyGridVPN"
            VALUE "ProductVersion", PG_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
