<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installers" (stage 2): the NSIS installers built from the
     stage-1 signed files. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="ProxyGridVPN" product-version="${version}">
      <include path="ProxyGridVPN-*-ia32.exe" />
      <include path="ProxyGridVPN-*-arm64.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
